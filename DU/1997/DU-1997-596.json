  {
   "type": "text",
   "text": "ROZPORZĄDZENIE RADY MINISTRÓW"
  },
  {
   "type": "text",
   "text": "z dnia 5 sierpnia 1997 r."
  },
  {
   "type": "text",
   "text": "w sprawie ustalenia wykazu gmin szczególnie dotkniętych powodzią."
  },
  {
   "type": "text",
   "text": "Na podstawie art. 53d pkt 1 ustawy budżetowej na rok 1997 z dnia 21 lutego 1997 r. (Dz. U. Nr 19, poz. 106 i Nr 80, poz. 510) zarządza się, co następuje:"
  },
  {
   "type": "par",
   "num": "1",
   "path": "par_1",
   "text": "Rozporządzenie określa gminy szczególnie dotknięte powodzią.",
   "children": []
  },
  {
   "type": "par",
   "num": "2",
   "path": "par_2",
   "text": "Wykaz gmin szczególnie dotkniętych powodzią określa załącznik do rozporządzenia.",
   "children": []
  },
  {
   "type": "par",
   "num": "3",
   "path": "par_3",
   "text": "Rozporządzenie wchodzi w życie z dniem ogłoszenia.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Prezes Rady Ministrów: W. Cimoszewicz"
  }
 ],
