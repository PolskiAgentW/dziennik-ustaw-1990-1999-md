  {
   "type": "text",
   "text": "ROZPORZĄDZENIE RADY MINISTRÓW"
  },
  {
   "type": "text",
   "text": "z dnia 19 maja 1998 r."
  },
  {
   "type": "text",
   "text": "w sprawie utworzenia Wyższej Szkoty Zawodowej w Tarnowie. Na podstawie art. 10 ust. 1 ustawy z dnia 26 czerwca 1997 r. o wyższych szkołach zawodowych (Dz. U. Nr 96, poz. 590) zarządza się, co następuje:"
  },
  {
   "type": "par",
   "num": "1",
   "path": "par_1",
   "text": "",
   "children": [
    {
     "type": "ust",
     "num": "1",
     "path": "par_1/ust_1",
     "text": "Tworzy się z dniem 1 lipca 1998 r. państwową wyższą szkołę zawodową pod nazwą „Wyższa Szkoła Zawodowa w Tarnowie”, zwaną dalej „Uczelnią”.",
     "children": []
    },
    {
     "type": "ust",
     "num": "2",
     "path": "par_1/ust_2",
     "text": "Siedzibą Uczelni jest miasto Tarnów.",
     "children": []
    }
   ]
  },
  {
   "type": "par",
   "num": "2",
   "path": "par_2",
   "text": "Uczelnia prowadzi następujące specjalności zawodowe:",
   "children": [
    {
     "type": "pkt",
     "num": "1",
     "path": "par_2/pkt_1",
     "text": "język polski,",
     "children": []
    },
    {
     "type": "pkt",
     "num": "2",
     "path": "par_2/pkt_2",
     "text": "język angielski,",
     "children": []
    },
    {
     "type": "pkt",
     "num": "3",
     "path": "par_2/pkt_3",
     "text": "język niemiecki,",
     "children": []
    },
    {
     "type": "pkt",
     "num": "4",
     "path": "par_2/pkt_4",
     "text": "język francuski,",
     "children": []
    },
    {
     "type": "pkt",
     "num": "5",
     "path": "par_2/pkt_5",
     "text": "wychowanie fizyczne z gimnastyką korekcyjną,",
     "children": []
    },
    {
     "type": "pkt",
     "num": "6",
     "path": "par_2/pkt_6",
     "text": "matematyka z informatyką,",
     "children": []
    },
    {
     "type": "pkt",
     "num": "7",
     "path": "par_2/pkt_7",
     "text": "chemia stosowana,",
     "children": []
    },
    {
     "type": "pkt",
     "num": "8",
     "path": "par_2/pkt_8",
     "text": "elektrotechnika z elektroniką.",
     "children": []
    }
   ]
  },
  {
   "type": "par",
   "num": "3",
   "path": "par_3",
   "text": "Rozporządzenie wchodzi w życie po upływie 14 dni od dnia ogłoszenia.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Prezes Rady Ministrów: J. Buzek"
  }
