         "children": []
        },
        {
         "type": "pkt",
         "num": "2",
         "path": "par_4/ust_1/pkt_2",
         "text": "Sekretariat Ministra,",
         "children": []
        },
        {
         "type": "pkt",
         "num": "3",
         "path": "par_4/ust_1/pkt_3",
         "text": "Biuro Dyrektora Generalnego,",
         "children": []
        },
        {
         "type": "pkt",
         "num": "4",
         "path": "par_4/ust_1/pkt_4",
         "text": "Departament Strategii i Planowania Polityki,",
         "children": []
        },
        {
         "type": "pkt",
         "num": "5",
         "path": "par_4/ust_1/pkt_5",
         "text": "Departament Polityki Bezpieczeństwa,",
         "children": []
        },
        {
         "type": "pkt",
         "num": "6",
         "path": "par_4/ust_1/pkt_6",
         "text": "Departament Krajów Pozaeuropejskich i Systemu Narodów Zjednoczonych,",
         "children": []
        },
        {
