  {
   "type": "par",
   "num": "4",
   "path": "par_4",
   "text": "Kobietom będącym żołnierzami zawodowymi, przy powołaniu do służby, wypłaca się dodatkowo:",
   "children": [
    {
     "type": "pkt",
     "num": "1",
     "path": "par_4/pkt_1",
     "text": "równoważnik pieniężny za nie wydane przedmioty umundurowania w naturze, w następującej wysokości:",
     "children": [
      {
       "type": "lit",
       "num": "a",
       "path": "par_4/pkt_1/lit_a",
       "text": "w jednostkach lądowych 177,00 zł,",
       "children": []
      },
      {
