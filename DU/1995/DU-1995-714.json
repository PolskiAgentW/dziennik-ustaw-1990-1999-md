  {
   "type": "text",
   "text": "ROZPORZĄDZENIE MINISTRA FINANSÓW"
  },
  {
   "type": "text",
   "text": "z dnia 13 grudnia 1995 r."
  },
  {
   "type": "text",
   "text": "w sprawie podatku od środków transportowych."
  },
  {
   "type": "text",
   "text": "Na podstawie art. 10 ust. 1 ustawy z dnia 12 stycznia 1991 r. o podatkach i opłatach lokalnych (Dz. U. Nr 9, poz. 31 i Nr 101, poz. 444, z 1992 r. Nr 21, poz. 86 i z 1994 r. Nr 123, poz. 600) zarządza się, co następuje:"
  },
  {
   "type": "par",
   "num": "1",
   "path": "par_1",
   "text": "Podatek od środków transportowych wynosi rocznie:",
   "children": [
    {
     "type": "pkt",
     "num": "1",
     "path": "par_1/pkt_1",
     "text": "od motorowerów 9zł,",
     "children": []
    },
    {
     "type": "pkt",
     "num": "2",
     "path": "par_1/pkt_2",
     "text": "od motocykli z silnikiem o pojemności skokowej:",
     "children": [
      {
       "type": "lit",
       "num": "a",
       "path": "par_1/pkt_2/lit_a",
       "text": "do 50 cm? włącznie 18 zt,",
       "children": []
      },
      {
       "type": "lit",
       "num": "b",
       "path": "par_1/pkt_2/lit_b",
       "text": "powyżej 50 cm? do 350 cm? włącznie 30 zt,",
       "children": []
      },
      {
       "type": "lit",
       "num": "c",
       "path": "par_1/pkt_2/lit_c",
       "text": "powyżej 350 cm? 150 zt,",
       "children": []
      }
     ]
    },
    {
     "type": "pkt",
     "num": "3",
