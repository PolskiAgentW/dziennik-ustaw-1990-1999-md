        {
         "type": "pkt",
         "num": "16",
         "path": "par_4/ust_1/pkt_16",
         "text": "Departament Zagraniczny,",
         "children": []
        },
        {
         "type": "pkt",
         "num": "17",
         "path": "par_4/ust_1/pkt_17",
         "text": "Departament Polityki Dewizowej i Współpracy Handlowej z Zagranicą,",
         "children": []
        },
        {
         "type": "pkt",
         "num": "18",
         "path": "par_4/ust_1/pkt_18",
         "text": "Departament Międzynarodowej Integracji Gospodarczej,",
         "children": []
        },
        {
         "type": "pkt",
         "num": "19",
         "path": "par_4/ust_1/pkt_19",
