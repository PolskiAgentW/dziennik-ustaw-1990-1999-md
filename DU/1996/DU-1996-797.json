         "num": "23",
         "path": "par_4/ust_1/pkt_23",
         "text": "Departament Cet,",
         "children": []
        },
        {
         "type": "pkt",
         "num": "24",
         "path": "par_4/ust_1/pkt_24",
         "text": "Departament Statystyki,",
         "children": []
        },
        {
         "type": "pkt",
         "num": "25",
         "path": "par_4/ust_1/pkt_25",
         "text": "Departament Gier Losowych i Zakładów Wzajemnych,",
         "children": []
        },
        {
         "type": "pkt",
         "num": "26",
         "path": "par_4/ust_1/pkt_26",
         "text": "Departament Spraw Majątkowych,",
         "children": []
        },
        {
         "type": "pkt",
         "num": "27",
         "path": "par_4/ust_1/pkt_27",
         "text": "Biuro Reformy Systemu Podatkowego,",
         "children": []
        },
        {
         "type": "pkt",
         "num": "26",
         "path": "par_4/ust_1/pkt_26",
         "text": "Biuro Kadr i Szkolenia,",
         "children": []
        },
        {
         "type": "pkt",
         "num": "29",
         "path": "par_4/ust_1/pkt_29",
         "text": "Biuro Prasowe,",
         "children": []
        },
        {
         "type": "pkt",
         "num": "30",
         "path": "par_4/ust_1/pkt_30",
         "text": "Biuro Administracyjno-Gospodarcze.",
         "children": []
        }
       ]
      },
      {
       "type": "ust",
       "num": "2",
       "path": "par_4/ust_2",
       "text": "Organizację wewnętrzną i szczegółowy zakres zadań komórek organizacyjnych oraz tryb pracy Ministerstwa określa regulamin organizacyjny, nadany przez Ministra na wniosek Dyrektora Generalnego.",
       "children": []
      },
      {
       "type": "ust",
       "num": "3",
       "path": "par_4/ust_3",
       "text": "Spory kompetencyjne między komórkami organizacyjnymi, o których mowa w ust. 1, rozstrzyga Minister. § 5. Ministrowi podlegają izby i urzędy skarbowe oraz urzędy kontroli skarbowej. § 6. 1. Minister nadzoruje:",
       "children": [
        {
         "type": "pkt",
         "num": "1",
         "path": "par_4/ust_3/pkt_1",
         "text": "Główny Urząd Cet,",
         "children": []
        },
        {
         "type": "pkt",
         "num": "2",
         "path": "par_4/ust_3/pkt_2",
         "text": "Instytut Finansów,",
         "children": []
        },
        {
         "type": "pkt",
         "num": "3",
         "path": "par_4/ust_3/pkt_3",
         "text": "Centrum Kształcenia Kadr Skarbowości w Białobrzegach k. Zegrza,",
         "children": []
        },
        {
         "type": "pkt",
         "num": "4",
         "path": "par_4/ust_3/pkt_4",
         "text": "Ośrodek Doskonalenia Zawodowego Kadr Resortu Finansów w Warszawie,",
         "children": []
        },
        {
         "type": "pkt",
         "num": "5",
         "path": "par_4/ust_3/pkt_5",
         "text": "Ośrodek Wypoczynkowo-Szkoleniowy „Bałtyk” w Jastrzębiej Górze. § 7. 1. W Ministerstwie działa, jako jednostka wyodrębniona, Gospodarstwo Pomocnicze „Zakład Obsługi Ministerstwa Finansów”.",
         "children": []
        }
       ]
      },
      {
       "type": "ust",
       "num": "2",
       "path": "par_4/ust_2",
       "text": "Nadzór zwierzchni nad Gospodarstwem Pomocniczym sprawuje Dyrektor Generalny.",
       "children": []
      },
      {
       "type": "ust",
       "num": "3",
       "path": "par_4/ust_3",
       "text": "Organizację wewnętrzną, szczegółowy zakres zadań oraz tryb pracy Gospodarstwa Pomocniczego określają odrębne przepisy oraz regulamin wewnętrzny zatwierdzony przez Dyrektora Generalnego.",
       "children": []
      }
     ]
    }
   ]
  }
 ],
